# .env.example — 只列名字，不填值
# 真实的值去 GitHub 仓库 Settings → Secrets and variables → Actions 里贴，
# 不要写进任何文件、不要发聊天里。

# 大模型 Key（DSA 必填；AlphaSift 可选，没有就纯规则模式）
GEMINI_API_KEY=

# 自选股（逗号分隔，6 位代码；初始值 002242,600519,000625）
STOCK_LIST=

# 以下变量是可选的，改默认值时才用（Repository variables 里设）：
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_FALLBACK=gemini-4-hydrogen
# LITELLM_MODEL=gemini/gemini-3.8-flash
# LITELLM_FALLBACK_MODELS=gemini/gemini-4-hydrogen
# REPORT_TYPE=simple

# 本平台没有推送：不要加 NOTIFY_URLS / EMAIL_* / SERVERCHAN_* 等任何通知类变量。
